generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          Role      @default(CS)
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Customer {
  id            String              @id @default(cuid())
  name          String
  phone         String              @unique
  company       String?
  domicile      String?
  status        String              @default("active")
  owner         String              @default("Karina")
  internalNotes String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  invoices      Invoice[]
  messages      Message[]
  qualification OrderQualification?
  projects      Project[]
  quotations    Quotation[]

  @@map("customers")
}

model Message {
  id            String   @id @default(cuid())
  customerId    String   @map("customer_id")
  sender        String
  text          String
  isRead        Boolean  @default(false)
  attachments   String[]
  wamid         String?  @unique
  replyToWamid  String?  @map("reply_to_wamid")
  createdAt     DateTime @default(now())
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model OrderQualification {
  id         String   @id @default(cuid())
  customerId String   @unique @map("customer_id")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  items      Json     @default("[]")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("order_qualifications")
}

model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

model Project {
  id         String        @id @default(cuid())
  customerId String        @map("customer_id")
  title      String
  value      Float
  pipeline   PipelineStage @default(DEAL)
  status     String        @default("active")
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  items      Json          @default("[]")
  deliveries Delivery[]
  invoices   Invoice[]
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotations Quotation[]

  @@map("projects")
}

model Quotation {
  id               String    @id @default(cuid())
  projectId        String?   @map("project_id")
  docNumber        String    @unique
  customerName     String
  amount           Float
  status           String    @default("Draft")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  customerId       String?   @map("customer_id")
  items            Json      @default("[]")
  customerCompany  String?
  customerDomicile String?
  customerPhone    String?
  customer         Customer? @relation(fields: [customerId], references: [id])
  project          Project?  @relation(fields: [projectId], references: [id])

  @@map("quotations")
}

model Invoice {
  id               String    @id @default(cuid())
  projectId        String?   @map("project_id")
  amount           Float
  type             String
  status           String    @default("UNPAID")
  dueDate          DateTime?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  customerName     String?
  docNumber        String?   @unique
  customerId       String?   @map("customer_id")
  items            Json      @default("[]")
  customerCompany  String?
  customerDomicile String?
  customerPhone    String?
  customer         Customer? @relation(fields: [customerId], references: [id])
  project          Project?  @relation(fields: [projectId], references: [id])

  @@map("invoices")
}

model Delivery {
  id             String    @id @default(cuid())
  projectId      String    @map("project_id")
  courier        String?
  trackingNumber String?
  status         String    @default("PENDING")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("deliveries")
}

model Inventory {
  id        String         @id @default(cuid())
  fabric    String
  color     String
  stockKg   Float          @default(0)
  updatedAt DateTime       @updatedAt
  logs      InventoryLog[]

  @@map("inventory")
}

model InventoryLog {
  id          String    @id @default(cuid())
  inventoryId String    @map("inventory_id")
  type        String
  amountKg    Float
  notes       String?
  createdAt   DateTime  @default(now())
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@map("inventory_logs")
}

model Employee {
  id          String       @id @default(cuid())
  employeeId  String       @unique
  name        String
  position    String
  department  String
  joinedAt    DateTime
  baseSalary  Float
  status      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[]
  payrolls    Payroll[]
  termination Termination?

  @@map("employees")
}

model Termination {
  id           String   @id @default(cuid())
  employeeId   String   @unique @map("employee_id")
  date         DateTime
  type         String
  reason       String?
  severancePay Float    @default(0)
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("terminations")
}

model Attendance {
  id         String    @id @default(cuid())
  employeeId String    @map("employee_id")
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("PRESENT")
  notes      String?
  createdAt  DateTime  @default(now())
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("attendances")
}

model Payroll {
  id           String    @id @default(cuid())
  employeeId   String    @map("employee_id")
  period       String
  baseSalary   Float
  allowance    Float     @default(0)
  deduction    Float     @default(0)
  dynamicBonus Float     @default(0)
  totalAmount  Float
  status       String    @default("UNPAID")
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("payrolls")
}

model Applicant {
  id        String   @id @default(cuid())
  name      String
  position  String
  email     String?
  phone     String
  resumeUrl String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("applicants")
}

model CashFlow {
  id          String   @id @default(cuid())
  date        DateTime
  type        String
  amount      Float
  category    String
  description String
  referenceId String?
  createdAt   DateTime @default(now())

  @@map("cash_flows")
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  amount      Float
  category    String
  description String
  receiptUrl  String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("expenses")
}

model TaxRecord {
  id          String    @id @default(cuid())
  period      String
  type        String
  amount      Float
  status      String    @default("UNPAID")
  paidAt      DateTime?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("tax_records")
}

model AdsLead {
  id            String   @id @default(cuid())
  source        String
  campaignName  String
  customerName  String
  customerPhone String
  customerEmail String?
  rawData       Json
  createdAt     DateTime @default(now())

  @@map("ads_leads")
}

model RoleSession {
  role         String   @id
  sessionToken String
  expiresAt    DateTime

  @@map("role_sessions")
}

enum Role {
  ADMIN
  CS
}

enum PipelineStage {
  DEAL
  PRE_PROD
  PROD
  DELIVERY
  PAYMENT
}

model Sop {
  id          String   @id @default(cuid())
  title       String
  content     String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("sops")
}

model Knowledge {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("knowledges")
}

model Persona {
  id               String   @id @default(cuid())
  tone             String   @default("ramah")
  coreInstructions String
  updatedAt        DateTime @updatedAt

  @@map("personas")
}

model Asset {
  id          String   @id @default(cuid())
  name        String
  type        String
  url         String
  size        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("assets")
}
